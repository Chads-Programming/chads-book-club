    "@types/react-dom": "^19",
    "@types/sequelize": "^4.28.20",
    "dotenv-cli": "^8.0.0",
    "sequelize-cli": "^6.6.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.2.8",
    "typescript": "^5"
