generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
    id    String  @id @default(cuid())
    username  String @unique
    bookSubmissions BookSubmission[]
    submissionVotes SubmissionVote[]
}

model BookSubmission {
  id    String  @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  bookId String
  coverUrl  String
  title  String
  author String
  votes SubmissionVote[]
}

model SubmissionVote{
  id String @id @default(cuid())
  bookSubmissionId String
  bookSubmission BookSubmission @relation(fields: [bookSubmissionId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
}
