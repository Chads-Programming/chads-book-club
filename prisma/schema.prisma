generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  username        String
  email           String?          @unique
  avatarUrl       String?
  accounts        Account[]
  bookSubmissions BookSubmission[]
  submissionVotes SubmissionVote[]
}

enum Provider {
  discord
}

model Account {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  provider       Provider
  providerUserId String
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
}

model BookSubmission {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  bookId      String           @unique
  coverUrl    String?
  title       String
  authors     String[]
  rating      Float
  description String
  votes       SubmissionVote[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model SubmissionVote {
  id               String         @id @default(cuid())
  bookSubmissionId String
  bookSubmission   BookSubmission @relation(fields: [bookSubmissionId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id])

  @@index([userId, bookSubmissionId])
}

model WeeklyBackup {
  id        String   @id @default(cuid())
  weekStart DateTime
  weekEnd   DateTime
  snapshot  Json
  createdAt DateTime @default(now())
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
